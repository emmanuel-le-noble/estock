# ============================================================
# eStock - Assets statiques uniquement
# Les pages PHP sont accessibles directement (pas de front controller)
# ============================================================

# Forcer leUTF-8
AddDefaultCharset utf-8

# Compresser les réponses
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
</IfModule>

# Protéger les dossiers sensibles
<FilesMatch "\.(php|sql|log|ini|env)$">
    <If "%{REQUEST_URI} =~ m#/(config|includes|database|vendor|templates)/#">
        Require all denied
    </If>
</FilesMatch>

# Blocage complémentaire via RewriteRule pour les sous-dossiers
RewriteRule ^(config|includes|database|vendor|templates)/ - [F,L]

# Autoriser l'accès public uniquement
<DirectoryMatch "^(assets|api|uploads|img)">
    Require all granted
</DirectoryMatch>
