# Forcer le UTF-8
AddDefaultCharset utf-8

# Ne jamais lister le contenu d'un répertoire en l'absence de fichier index.
Options -Indexes

# Secrets et métadonnées de déploiement : uniquement accessibles localement.
<FilesMatch "^(\.env|composer\.(json|lock)|phpunit\.xml)$">
    Require all denied
</FilesMatch>

# Compresser les réponses
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
</IfModule>

# Fichier par défaut
DirectoryIndex index.php

# Activer le moteur de réécriture (Indispensable pour vos règles)
RewriteEngine On

# Blocage des dossiers sensibles
RewriteRule ^(config|includes|database|vendor|templates|bin|tests|backups|logs|archives|var|docs)/ - [F,L]

# Note : On ne peut pas utiliser <DirectoryMatch> ici.
# Si vous voulez restreindre l'accès à certains dossiers, 
# il faut utiliser des fichiers .htaccess dans ces dossiers spécifiques 
# ou laisser Apache gérer cela via la configuration principale.
