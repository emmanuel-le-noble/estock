# ============================================================
# eStock — Modèle de fichier de configuration d'environnement
# ============================================================
# Copiez ce fichier en .env et remplissez les valeurs :
#   cp .env.example .env

# --- Base de données ---
DB_HOST=127.0.0.1
DB_NAME=estock_db
DB_USER=root
# Facultatif en development si votre MySQL local n'a pas de mot de passe.
# Obligatoire en production.
DB_PASS=

# --- Sécurité ---
# Clé secrète pour les signatures HMAC (minimum 32 caractères)
# Générez une clé aléatoire : openssl rand -hex 32
SECRET_URL_KEY=

# --- Environnement ---
# development : mode local, mot de passe MySQL vide autorisé
# production : valeurs sensibles requises, sans fallback
# La valeur par défaut du code est production si APP_ENV manque.
APP_ENV=development

# --- Fuseau horaire ---
# Liste des fuseaux : https://www.php.net/manual/en/timezones.php
APP_TIMEZONE=Africa/Lome
