# ============================================================
# eStock — Modèle de fichier de configuration d'environnement
# ============================================================
# Copiez ce fichier en .env et remplissez les valeurs :
#   cp .env.example .env

# --- Base de données ---
DB_HOST=127.0.0.1
DB_NAME=estock_db
DB_USER=root
DB_PASS=votre_mot_de_passe_ici

# --- Sécurité ---
# Clé secrète pour les signatures HMAC (minimum 32 caractères)
# Générez une clé aléatoire : openssl rand -hex 32
SECRET_URL_KEY=votre_cle_secrete_au_moins_32_caracteres_ici

# --- Environnement ---
# development : mode debug, fallbacks autorisés
# production : erreurs fatales si configuration manquante
APP_ENV=development

# --- Fuseau horaire ---
# Liste des fuseaux : https://www.php.net/manual/en/timezones.php
APP_TIMEZONE=Africa/Lome
