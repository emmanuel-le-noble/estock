{% extends "base.html.twig" %}

{% block body %}
<div class="card shadow-sm mb-4">
    <div class="card-body">
        <div class="alert alert-info d-flex align-items-start gap-2">
            <i class="bi bi-file-earmark-text fs-5"></i>
            <div>
                <strong>Fichier des Écritures Comptables (FEC)</strong> — export conforme à la
                norme DGFiP (CGI art. 47 A, arrêté du 26/12/2013) : 17 colonnes obligatoires,
                fichier texte UTF-8 séparé « ; ». Pour la transmission à votre comptable ou à
                l'administration fiscale.
            </div>
        </div>

        <form method="get" action="export_fec.php" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small">Du</label>
                <input type="date" name="debut" class="form-control" value="{{ debut }}" required>
            </div>
            <div class="col-md-3">
                <label class="form-label small">Au</label>
                <input type="date" name="fin" class="form-control" value="{{ fin }}" required>
            </div>
            {% if magasins|default([])|length > 1 %}
            <div class="col-md-3">
                <label class="form-label small">Magasin</label>
                <select name="magasin_id" class="form-select">
                    <option value="0">Tous les magasins</option>
                    {% for m in magasins %}
                        <option value="{{ m.id }}" {{ magasin_id == m.id ? 'selected' : '' }}>{{ m.nom }}</option>
                    {% endfor %}
                </select>
            </div>
            {% endif %}
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-search"></i> Afficher l'aperçu</button>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h6 class="mb-0">Écritures de la période ({{ debut }} → {{ fin }})</h6>
            <a href="export_fec.php?debut={{ debut }}&fin={{ fin }}&magasin_id={{ magasin_id }}&export=1"
               class="btn btn-success">
                <i class="bi bi-download"></i> Télécharger le fichier FEC
            </a>
        </div>

        <div class="row text-center g-3">
            <div class="col-md-4">
                <div class="border rounded p-3">
                    <div class="fs-3 fw-bold text-primary">{{ apercu.ventes }}</div>
                    <div class="small text-muted">Journal VT — Ventes (factures)</div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="border rounded p-3">
                    <div class="fs-3 fw-bold text-success">{{ apercu.achats }}</div>
                    <div class="small text-muted">Journal AC — Achats (réceptions)</div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="border rounded p-3">
                    <div class="fs-3 fw-bold text-warning">{{ apercu.depenses }}</div>
                    <div class="small text-muted">Journal DG — Dépenses</div>
                </div>
            </div>
        </div>

        <p class="small text-muted mt-3 mb-0">
            Les écritures d'annulation (factures « Annulée ») sont contre-passées dans le
            journal VT. Fichier nommé <code>FEC_&lt;base&gt;_&lt;début&gt;_&lt;fin&gt;.txt</code>.
        </p>
    </div>
</div>
{% endblock %}