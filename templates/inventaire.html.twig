{% extends "base.html.twig" %}
{% block title %}Inventaire physique{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <h1 class="h4 mb-0"><i class="bi bi-clipboard-check"></i> Inventaire physique</h1>
    {% if view == 'liste' and peut_gerer %}
    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalNouvelInv">
        <i class="bi bi-plus-lg"></i> Nouvelle session
    </button>
    {% endif %}
    {% if view == 'detail' %}
    <a href="{{ base_url }}inventaire.php" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Retour</a>
    {% endif %}
</div>



{# ======================== LISTE ======================== #}
{% if view == 'liste' %}

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form method="get" action="{{ base_url }}inventaire.php" class="row g-2">
            <div class="col-md-4">
                <input type="text" name="search" class="form-control" placeholder="Référence ou créateur…" value="{{ filters.search }}">
            </div>
            <div class="col-md-3">
                <select name="statut" class="form-select">
                    <option value="">Tous statuts</option>
                    {% for s in ['En cours','Validé','Annulé'] %}
                    <option value="{{ s }}" {{ filters.statut == s ? 'selected' : '' }}>{{ s }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-auto">
                <button class="btn btn-outline-primary"><i class="bi bi-search"></i> Filtrer</button>
                <a href="{{ base_url }}inventaire.php" class="btn btn-outline-secondary">Réinitialiser</a>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Référence</th>
                    <th>Magasin</th>
                    <th>Statut</th>
                    <th>Articles comptés</th>
                    <th>Créateur</th>
                    <th>Date début</th>
                    <th>Date fin</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            {% for row in rows %}
            <tr>
                <td><strong>{{ row.reference }}</strong></td>
                <td>{{ row.nom_magasin|default('—') }}</td>
                <td>
                    {% set badge = {'En cours':'warning','Validé':'success','Annulé':'secondary'} %}
                    <span class="badge bg-{{ badge[row.statut]|default('secondary') }}">{{ row.statut }}</span>
                </td>
                <td>{{ row.nb_lignes }}</td>
                <td>{{ row.createur_nom|default('—') }}</td>
                <td>{{ row.date_debut|date('d/m/Y') }}</td>
                <td>{{ row.date_fin ? row.date_fin|date('d/m/Y') : '—' }}</td>
                <td>
                    <a href="{{ url_sign('inventaire.php', row.id, {'action':'detail'}) }}" class="btn btn-sm btn-outline-primary">
                        <i class="bi bi-eye"></i> Voir
                    </a>
                </td>
            </tr>
            {% else %}
            <tr><td colspan="8" class="text-center text-muted py-4">Aucun inventaire trouvé.</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
    {% if pagination.total_pages > 1 %}
    <div class="card-footer">{{ pagination_links(pagination, 'inventaire.php', filters) }}</div>
    {% endif %}
</div>

{# Modal nouvelle session #}
{% if peut_gerer %}
<div class="modal fade" id="modalNouvelInv" tabindex="-1">
    <div class="modal-dialog">
        <form method="post" action="{{ base_url }}inventaire.php?action=nouveau" class="modal-content">
            {{ csrf_field()|raw }}
            <div class="modal-header"><h5 class="modal-title">Nouvelle session d'inventaire</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                {% if magasins|length > 1 %}
                <div class="mb-3">
                    <label class="form-label">Magasin</label>
                    <select name="magasin_id" class="form-select" required>
                        {% for mag in magasins %}
                        <option value="{{ mag.id }}">{{ mag.nom }}</option>
                        {% endfor %}
                    </select>
                </div>
                {% else %}
                <input type="hidden" name="magasin_id" value="{{ magasins[0].id ?? 1 }}">
                {% endif %}
                <div class="mb-3">
                    <label class="form-label">Notes (optionnel)</label>
                    <textarea name="notes" class="form-control" rows="2" maxlength="500"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                <button class="btn btn-primary"><i class="bi bi-plus-lg"></i> Créer</button>
            </div>
        </form>
    </div>
</div>
{% endif %}

{# ======================== DETAIL ======================== #}
{% elseif view == 'detail' %}
{% set badge = {'En cours':'warning','Validé':'success','Annulé':'secondary'} %}

<div class="row mb-3">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-body">
                <h5>{{ inv.reference }}
                    <span class="badge bg-{{ badge[inv.statut]|default('secondary') }} ms-2">{{ inv.statut }}</span>
                </h5>
                <div class="text-muted small">Magasin : <strong>{{ inv.nom_magasin|default('—') }}</strong></div>
                <div class="text-muted small">Créé par : {{ inv.createur_nom|default('—') }} le {{ inv.date_debut|date('d/m/Y H:i') }}</div>
                {% if inv.date_fin %}<div class="text-muted small">Clôturé le : {{ inv.date_fin|date('d/m/Y H:i') }}</div>{% endif %}
                {% if inv.notes %}<div class="mt-2">{{ inv.notes }}</div>{% endif %}
            </div>
            {% if inv.statut == 'En cours' and peut('inventaire_gerer') %}
            <div class="card-footer d-flex gap-2">
                <form method="post" action="{{ base_url }}inventaire.php?action=valider" data-confirm="Valider et appliquer tous les écarts au stock ?">
                    {{ csrf_field()|raw }}
                    <input type="hidden" name="id" value="{{ inv.id }}">
                    <button class="btn btn-success btn-sm"><i class="bi bi-check-circle"></i> Valider l'inventaire</button>
                </form>
                <form method="post" action="{{ base_url }}inventaire.php?action=annuler" data-confirm="Annuler cette session sans modifier le stock ?">
                    {{ csrf_field()|raw }}
                    <input type="hidden" name="id" value="{{ inv.id }}">
                    <button class="btn btn-outline-danger btn-sm"><i class="bi bi-x-circle"></i> Annuler</button>
                </form>
            </div>
            {% endif %}
        </div>
    </div>
    <div class="col-md-6">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <div class="row g-3 text-center">
                    <div class="col-4">
                        <div class="display-6 fw-bold text-primary">{{ lignes|length }}</div>
                        <div class="text-muted small">Articles comptés</div>
                    </div>
                    <div class="col-4">
                        <div class="display-6 fw-bold text-danger">
                            {{ lignes|filter(l => l.ecart < 0)|length }}
                        </div>
                        <div class="text-muted small">Manquants</div>
                    </div>
                    <div class="col-4">
                        <div class="display-6 fw-bold text-success">
                            {{ lignes|filter(l => l.ecart > 0)|length }}
                        </div>
                        <div class="text-muted small">Excédents</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

{# Formulaire de saisie (uniquement si session en cours) #}
{% if inv.statut == 'En cours' and peut('inventaire_gerer') %}
<div class="card shadow-sm mb-4">
    <div class="card-header"><h6 class="mb-0"><i class="bi bi-upc-scan"></i> Saisir un comptage</h6></div>
    <div class="card-body">
        <div class="row g-2 align-items-end" id="formSaisie">
            <div class="col-md-5">
                <label class="form-label">Article (scan ou sélection)</label>
                <input type="text" id="scanInput" class="form-control" placeholder="Scanner le code-barres ou taper le nom…" autocomplete="off">
                <input type="hidden" id="articleId">
            </div>
            <div class="col-md-3">
                <label class="form-label">Stock système</label>
                <input type="number" id="qteTheor" class="form-control" readonly placeholder="—">
            </div>
            <div class="col-md-2">
                <label class="form-label">Qté comptée</label>
                <input type="number" id="qteComptee" class="form-control" min="0" value="0">
            </div>
            <div class="col-md-2">
                <label class="form-label">&nbsp;</label>
                <button id="btnSaisir" class="btn btn-primary w-100"><i class="bi bi-save"></i> Saisir</button>
            </div>
        </div>
        <div id="saisieMsg" class="mt-2"></div>
        <div class="mt-2 small">
            <input type="text" id="articleSearch" class="form-control form-control-sm" placeholder="Recherche article…" style="max-width:300px">
            <div id="articleSuggestions" class="list-group mt-1" style="max-width:400px;max-height:200px;overflow-y:auto;position:absolute;z-index:100"></div>
        </div>
    </div>
</div>
{% endif %}

{# Tableau des lignes #}
<div class="card shadow-sm">
    <div class="card-header d-flex justify-content-between">
        <h6 class="mb-0">Lignes de comptage ({{ lignes|length }})</h6>
    </div>
    <div class="table-responsive">
        <table class="table table-sm table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Article</th>
                    <th>Code-barres</th>
                    <th class="text-center">Théorique</th>
                    <th class="text-center">Compté</th>
                    <th class="text-center">Écart</th>
                    <th>Notes</th>
                </tr>
            </thead>
            <tbody>
            {% for l in lignes %}
            <tr class="{{ l.ecart < 0 ? 'table-danger' : (l.ecart > 0 ? 'table-warning' : '') }}">
                <td>{{ l.article_nom }}</td>
                <td><code>{{ l.code_barre }}</code></td>
                <td class="text-center">{{ l.quantite_theorique }}</td>
                <td class="text-center">{{ l.quantite_comptee }}</td>
                <td class="text-center">
                    {% if l.ecart > 0 %}<span class="badge bg-warning text-dark">+{{ l.ecart }}</span>
                    {% elseif l.ecart < 0 %}<span class="badge bg-danger">{{ l.ecart }}</span>
                    {% else %}<span class="badge bg-success">0</span>{% endif %}
                </td>
                <td class="text-muted small">{{ l.notes|default('') }}</td>
            </tr>
            {% else %}
            <tr><td colspan="6" class="text-center text-muted py-4">Aucun article compté pour l'instant.</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endif %}{# end view #}
{% endblock body %}

{% block scripts_extra %}
{% if view == 'detail' and inv is defined and inv.statut == 'En cours' and peut('inventaire_gerer') %}
<script nonce="{{ csp_nonce_val }}">
(function() {
    const CSRF      = document.querySelector('meta[name="csrf-token"]')?.content || '';
    const INV_ID    = {{ inv.id }};
    const BASE      = window.BASE_URL || '';
    const articles  = {{ articles|json_encode|raw }};

    const scanInput  = document.getElementById('scanInput');
    const articleId  = document.getElementById('articleId');
    const qteTheor   = document.getElementById('qteTheor');
    const qteComptee = document.getElementById('qteComptee');
    const btnSaisir  = document.getElementById('btnSaisir');
    const saisieMsg  = document.getElementById('saisieMsg');
    const searchInput  = document.getElementById('articleSearch');
    const suggestions  = document.getElementById('articleSuggestions');

    function escapeHtml(str) {
        if (str == null) return '';
        return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;');
    }

    function selectArticle(art) {
        articleId.value = art.id;
        scanInput.value = art.nom + ' [' + art.code_barre + ']';
        qteTheor.value  = art.quantite_stock;
        qteComptee.value = 0;
        qteComptee.focus();
        suggestions.innerHTML = '';
        searchInput.value = '';
    }

    // Scan code-barres (touche Entrée dans scanInput)
    scanInput.addEventListener('keydown', function(e) {
        if (e.key !== 'Enter') return;
        e.preventDefault();
        const val = this.value.trim();
        const art = articles.find(a => a.code_barre === val);
        if (art) { selectArticle(art); }
        else { saisieMsg.innerHTML = '<span class="text-danger">Article non trouvé.</span>'; }
    });

    // Recherche texte
    searchInput.addEventListener('input', function() {
        const q = this.value.trim().toLowerCase();
        if (q.length < 2) { suggestions.innerHTML = ''; return; }
        const found = articles.filter(a =>
            a.nom.toLowerCase().includes(q) || (a.code_barre && a.code_barre.includes(q))
        ).slice(0, 15);
        suggestions.innerHTML = found.map(a =>
            '<button type="button" class="list-group-item list-group-item-action py-1" data-id="' + a.id + '">' + escapeHtml(a.nom) + ' <code>' + escapeHtml(a.code_barre) + '</code></button>'
        ).join('');
        suggestions.querySelectorAll('button').forEach(btn => {
            btn.addEventListener('click', function() {
                const art = articles.find(a => a.id == this.dataset.id);
                if (art) selectArticle(art);
            });
        });
    });

    // Saisir le comptage
    btnSaisir.addEventListener('click', function() {
        const aid = parseInt(articleId.value);
        if (!aid) { saisieMsg.innerHTML = '<span class="text-danger">Sélectionnez d\'abord un article.</span>'; return; }
        const qte = parseInt(qteComptee.value);
        if (isNaN(qte) || qte < 0) { saisieMsg.innerHTML = '<span class="text-danger">Quantité invalide.</span>'; return; }

        const form = new URLSearchParams();
        form.append('csrf_token', CSRF);
        form.append('inventaire_id', INV_ID);
        form.append('article_id', aid);
        form.append('quantite_comptee', qte);

        btnSaisir.disabled = true;
        fetch(BASE + 'inventaire.php?action=saisie', { method: 'POST', body: form })
            .then(r => r.json())
            .then(data => {
                if (data.ok) {
                    saisieMsg.innerHTML = `<span class="text-success">✓ Ligne enregistrée. Écart : <strong>${data.ecart >= 0 ? '+' : ''}${data.ecart}</strong></span>`;
                    scanInput.value = '';
                    articleId.value = '';
                    qteTheor.value  = '';
                    qteComptee.value = 0;
                    // Rafraîchir le tableau après 600ms
                    setTimeout(() => location.reload(), 1200);
                } else {
                    saisieMsg.innerHTML = '<span class="text-danger">' + escapeHtml(data.msg) + '</span>';
                }
            })
            .catch(() => { saisieMsg.innerHTML = '<span class="text-danger">Erreur réseau.</span>'; })
            .finally(() => { btnSaisir.disabled = false; });
    });

    // Raccourci clavier : Entrée sur qteComptee déclenche saisie
    qteComptee.addEventListener('keydown', function(e) {
        if (e.key === 'Enter') { e.preventDefault(); btnSaisir.click(); }
    });
})();
</script>
{% endif %}
{% endblock scripts_extra %}
