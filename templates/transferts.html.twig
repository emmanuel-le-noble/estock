{% extends 'base.html.twig' %}

{% block body %}
    <div class="d-flex justify-content-end mb-3">
        {% if can_transfer|default(false) %}
            <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalTransfert">
                <i class="bi bi-plus-lg"></i> Nouveau transfert
            </button>
        {% endif %}
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Date</th>
                            <th>Article</th>
                            <th>Code-barres</th>
                            <th>Source</th>
                            <th>Destination</th>
                            <th class="text-center">Qté</th>
                            <th>Motif</th>
                            <th>Opérateur</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for t in transferts|default([]) %}
                            <tr>
                                <td>{{ date_fr(t.date_transfert) }}</td>
                                <td class="fw-semibold">{{ t.article_nom|e }}</td>
                                <td><code>{{ t.code_barre|e }}</code></td>
                                <td>{{ t.source_nom|e }}</td>
                                <td>{{ t.destination_nom|e }}</td>
                                <td class="text-center fw-bold">{{ t.quantite }}</td>
                                <td>{{ t.motif|e ?: '—' }}</td>
                                <td>{{ t.utilisateur_nom|e ?: 'Système' }}</td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="8" class="text-center text-muted py-4">
                                    <i class="bi bi-inbox fs-1 d-block mb-2"></i> Aucun transfert enregistré.
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    {% if can_transfer|default(false) %}
    <div class="modal fade" id="modalTransfert" tabindex="-1">
        <div class="modal-dialog">
            <form method="post" class="modal-content">
                {{ csrf_field() }}
                <input type="hidden" name="action" value="transferer">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-arrow-left-right"></i> Nouveau transfert</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Article *</label>
                        <select name="article_id" class="form-select" required>
                            <option value="">— Sélectionner —</option>
                            {% for a in articles|default([]) %}
                                <option value="{{ a.id }}">{{ a.nom|e }} ({{ a.code_barre|e }})</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="row g-3">
                        <div class="col-6">
                            <label class="form-label">Magasin source *</label>
                            <select name="magasin_source_id" class="form-select" required>
                                <option value="">— Sélectionner —</option>
                                {% for m in magasins|default([]) %}
                                    <option value="{{ m.id }}" {{ m.id == (magasin_id|default(0)) ? 'selected' : '' }}>{{ m.nom|e }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label">Magasin destination *</label>
                            <select name="magasin_destination_id" class="form-select" required>
                                <option value="">— Sélectionner —</option>
                                {% for m in magasins|default([]) %}
                                    <option value="{{ m.id }}">{{ m.nom|e }}</option>
                                {% endfor %}
                            </select>
                        </div>
                    </div>
                    <div class="row g-3 mt-1">
                        <div class="col-6">
                            <label class="form-label">Quantité *</label>
                            <input type="number" name="quantite" min="1" class="form-control" required value="1">
                        </div>
                        <div class="col-6">
                            <label class="form-label">Motif</label>
                            <input type="text" name="motif" class="form-control" placeholder="ex : Réappro, rééquilibrage...">
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Annuler</button>
                    <button class="btn btn-primary"><i class="bi bi-send"></i> Transférer</button>
                </div>
            </form>
        </div>
    </div>
    {% endif %}
{% endblock %}
