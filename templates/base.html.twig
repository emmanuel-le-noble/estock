{# templates/base.html.twig - Layout maitre eStock #}

{% set user = current_user %}
{% set role = current_role %}
{% set app_nom = param_app_name() %}
{% set nom_parts = user.nom|default('U')|trim|split(' ')|filter(part => part|trim != '') %}
{% set initiale = ((nom_parts[0]|default('U')|slice(0,1)) ~ (nom_parts[1]|default('')|slice(0,1)))|upper %}

{# ---- Theme ---- #}
{% set theme_palettes = {
    'indigo':  ['#155bd0','#1049ad','#edf4ff'],
    'emerald': ['#10b981','#059669','#ecfdf5'],
    'sky':     ['#0ea5e9','#0284c7','#e0f2fe'],
    'rose':    ['#f43f5e','#e11d48','#fff1f2'],
    'amber':   ['#f59e0b','#d97706','#fffbeb']
} %}
{% set theme_colour = param('theme_couleur', 'indigo') %}
{% set theme_vars = theme_palettes[theme_colour]|default(theme_palettes.indigo) %}

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="csrf-token" content="{{ csrf_token|e('html_attr') }}">
    <link rel="manifest" href="{{ base_url }}manifest.php">
    <meta name="theme-color" content="#155bd0">
    <title>{{ titre_page|default(app_nom) }} · {{ app_nom }}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link href="{{ base_url }}assets/css/style.css?v=13" rel="stylesheet">
    <link rel="icon" type="image/x-icon" href="{{ base_url }}assets/images/logo-eStock.ico">
    <style>
        :root {
            --brand: {{ theme_vars[0]|escape('css') }};
            --brand-2: {{ theme_vars[1]|escape('css') }};
            --brand-soft: {{ theme_vars[2]|escape('css') }};
        }
    </style>
    {% block head_extra %}{% endblock %}
</head>
<body>

<canvas id="particleCanvas" aria-hidden="true"></canvas>

{% if is_logged_in %}
<div class="app-shell">

    <header class="app-header">
        <div class="app-header-main">
            <a class="app-brand" href="tableau_bord.php" aria-label="{{ app_nom }}, accueil">
                <span class="app-brand-mark"><img src="{{ base_url }}assets/images/logo-eStock-3.png" alt=""></span>
                <span class="app-brand-copy"><strong>{{ app_nom }}</strong><small>Gestion commerciale</small></span>
            </a>
            <button class="burger" id="burger" type="button" aria-label="Ouvrir la navigation" aria-expanded="false" aria-controls="sidebar">
                <i class="bi bi-list" aria-hidden="true"></i>
            </button>
            <div class="app-header-tools">
                <span id="connectionBadge" class="connection-status" aria-label="État de connexion"></span>
                {% if can_bill %}
                    <a href="caisse.php" class="btn btn-success btn-sm quick-pos"><i class="bi bi-cart-check"></i><span>Caisse</span></a>
                {% endif %}
                {% if can_manage_stock %}
                    <a href="suggestions_achat.php" aria-label="Alertes de stock" class="btn btn-sm position-relative tool-icon {{ (nb_alertes_topbar|default(0)) > 0 ? 'btn-outline-warning' : 'btn-outline-secondary' }}" title="Alertes stock">
                        <i class="bi bi-bell"></i>
                        {% if (nb_alertes_topbar|default(0)) > 0 %}<span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">{{ nb_alertes_topbar }}</span>{% endif %}
                    </a>
                {% endif %}
                {% if peut('stock_consulter') and (nb_alertes_peremption|default(0)) > 0 %}
                    <a href="peremptions.php" aria-label="Alertes de péremption" class="btn btn-sm btn-outline-danger position-relative tool-icon" title="Alertes péremption">
                        <i class="bi bi-calendar-week"></i><span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">{{ nb_alertes_peremption }}</span>
                    </a>
                {% endif %}
                <a href="profil.php" class="account-link" title="Mon profil" aria-label="Profil de {{ user.nom|default('')|e }}, rôle {{ role|e }}">
                    <span class="avatar avatar-initial">{{ initiale }}</span>
                    <span class="account-meta"><strong>{{ user.nom|default('') }}</strong><small><i class="bi bi-person-badge" aria-hidden="true"></i>{{ role }}</small></span>
                    <i class="bi bi-chevron-right account-caret" aria-hidden="true"></i>
                </a>
                <form method="POST" action="auth/logout.php" class="logout-form">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token }}">
                    <button type="submit" class="logout-button" title="Se déconnecter" aria-label="Se déconnecter"><i class="bi bi-box-arrow-right"></i></button>
                </form>
            </div>
        </div>
    </header>

    <nav class="primary-nav" id="sidebar" aria-label="Navigation principale">
            <div class="primary-nav-inner">
                <div class="nav-caption" aria-hidden="true">Espace de travail</div>
                <a href="tableau_bord.php" class="nav-home {{ page_courante == 'tableau_bord' ? 'active' : '' }}" {% if page_courante == 'tableau_bord' %}aria-current="page"{% endif %}>
                    <i class="bi bi-house-door"></i><span>Accueil</span>
                </a>

            {# ── Construction des sections ── #}
            {% set sections = [] %}

            {# PILOTAGE #}
            {% set items_pilotage = [{'slug': 'tableau_bord', 'label': 'Accueil', 'icon': 'bi-speedometer2', 'color': 'clr-indigo'}] %}
            {% if can_admin %}
                {% set items_pilotage = items_pilotage|merge([{'slug': 'statistiques', 'label': 'Statistiques', 'icon': 'bi-graph-up', 'color': 'clr-indigo'}]) %}
            {% endif %}
            {% set items_pilotage = items_pilotage|merge([{'slug': 'documentation', 'label': 'Documentation', 'icon': 'bi-journal-bookmark', 'color': 'clr-indigo'}]) %}
            {% set sections = sections|merge([{'key': 'pilotage', 'titre': 'Pilotage', 'icon': 'bi-speedometer2', 'items': items_pilotage}]) %}

            {# STOCK & ACHATS #}
            {% set items_stock = [] %}
            {% if can_manage_stock %}
                {% set items_stock = items_stock|merge([
                    {'slug': 'stock', 'label': 'Stock', 'icon': 'bi-boxes', 'color': 'clr-emerald'},
                    {'slug': 'articles', 'label': 'Articles', 'icon': 'bi-box-seam', 'color': 'clr-emerald'}
                ]) %}
                {% if peut('articles_gerer') %}
                    {% set items_stock = items_stock|merge([{'slug': 'categories', 'label': 'Catégories', 'icon': 'bi-tags', 'color': 'clr-emerald'}]) %}
                {% endif %}
                {% set items_stock = items_stock|merge([{'slug': 'fournisseurs', 'label': 'Fournisseurs', 'icon': 'bi-truck', 'color': 'clr-emerald'}]) %}
                {% if peut('achats_consulter') %}
                    {% set items_stock = items_stock|merge([{'slug': 'commandes_fournisseur', 'label': "Commandes d'achat", 'icon': 'bi-cart-plus', 'color': 'clr-emerald'}]) %}
                {% endif %}
                {% if peut('inventaire_consulter') %}
                    {% set items_stock = items_stock|merge([{'slug': 'inventaire', 'label': 'Inventaire', 'icon': 'bi-clipboard-check', 'color': 'clr-emerald'}]) %}
                {% endif %}
                {% set items_stock = items_stock|merge([
                    {'slug': 'mouvements', 'label': 'Mouvements', 'icon': 'bi-arrow-left-right', 'color': 'clr-emerald'},
                    {'slug': 'peremptions', 'label': 'Péremptions', 'icon': 'bi-calendar-week', 'color': 'clr-emerald', 'badge': nb_alertes_peremption|default(0)},
                    {'slug': 'suggestions_achat', 'label': "Suggestions d'achat", 'icon': 'bi-bag-check', 'color': 'clr-emerald', 'badge': nb_alertes_topbar|default(0)}
                ]) %}
                {% if current_role in ['Directeur', 'Admin', 'Magasinier'] %}
                    {% set items_stock = items_stock|merge([
                        {'slug': 'etiquettes', 'label': 'Étiquettes rayon', 'icon': 'bi-tag', 'color': 'clr-emerald'},
                        {'slug': 'transferts', 'label': 'Transferts', 'icon': 'bi-arrow-repeat', 'color': 'clr-emerald'}
                    ]) %}
                {% endif %}
            {% endif %}
            {% if items_stock|length > 0 %}
                {% set sections = sections|merge([{'key': 'stock', 'titre': 'Stock & Achats', 'icon': 'bi-boxes', 'items': items_stock}]) %}
            {% endif %}

            {# VENTES & CAISSE #}
            {% set items_ventes = [] %}
            {% if can_bill %}
                {% set items_ventes = items_ventes|merge([
                    {'slug': 'caisse', 'label': 'Caisse (POS)', 'icon': 'bi-cash-coin', 'color': 'clr-sky'},
                    {'slug': 'factures', 'label': 'Factures', 'icon': 'bi-receipt', 'color': 'clr-sky'}
                ]) %}
                {% if peut('retours_consulter') %}
                    {% set items_ventes = items_ventes|merge([{'slug': 'retours', 'label': 'Retours / SAV', 'icon': 'bi-arrow-counterclockwise', 'color': 'clr-sky'}]) %}
                {% endif %}
                {% if peut('promotions_consulter') %}
                    {% set items_ventes = items_ventes|merge([{'slug': 'promotions', 'label': 'Promotions & Remises', 'icon': 'bi-percent', 'color': 'clr-sky'}]) %}
                {% endif %}
                {% set items_ventes = items_ventes|merge([{'slug': 'cloture', 'label': 'Clôture de Caisse', 'icon': 'bi-lock-fill', 'color': 'clr-sky'}]) %}
                {% if peut('clients_consulter') %}
                    {% set items_ventes = items_ventes|merge([{'slug': 'clients', 'label': 'Clients & fidélité', 'icon': 'bi-people', 'color': 'clr-sky'}]) %}
                {% endif %}
            {% endif %}
            {% if items_ventes|length > 0 %}
                {% set sections = sections|merge([{'key': 'ventes', 'titre': 'Ventes & Caisse', 'icon': 'bi-cash-coin', 'items': items_ventes}]) %}
            {% endif %}

            {# ADMINISTRATION #}
            {% set items_admin = [] %}
            {% if can_admin %}
                {% set items_admin = items_admin|merge([
                    {'slug': 'depenses', 'label': 'Dépenses', 'icon': 'bi-wallet2', 'color': 'clr-rose'},
                    {'slug': 'utilisateurs', 'label': 'Utilisateurs', 'icon': 'bi-people', 'color': 'clr-violet'},
                    {'slug': 'magasins', 'label': 'Magasins', 'icon': 'bi-shop', 'color': 'clr-violet'},
                    {'slug': 'parametres', 'label': 'Paramètres', 'icon': 'bi-gear', 'color': 'clr-violet'}
                ]) %}
                {% if peut('utilisateurs_gerer') %}
                    {% set items_admin = items_admin|merge([{'slug': 'droits', 'href': 'parametres.php?tab=droits', 'label': 'Droits d’utilisation', 'icon': 'bi-shield-lock', 'color': 'clr-violet'}]) %}
                {% endif %}
            {% endif %}
            {% if peut('audit_consulter') %}
                {% set items_admin = items_admin|merge([{'slug': 'audit', 'label': "Journal d'activité", 'icon': 'bi-clock-history', 'color': 'clr-slate'}]) %}
            {% endif %}
            {% if peut('audit_consulter') %}
                {% set items_admin = items_admin|merge([{'slug': 'conformite', 'label': 'Traçabilité des ventes', 'icon': 'bi-shield-check', 'color': 'clr-slate'}]) %}
            {% endif %}
            {% if items_admin|length > 0 %}
                {% set sections = sections|merge([{'key': 'admin', 'titre': 'Administration', 'icon': 'bi-gear', 'items': items_admin}]) %}
            {% endif %}

            {# ── Rendu des menus de navigation ── #}
            {% for sec in sections %}
                {% set active_dans = page_courante != 'tableau_bord' and sec.items|filter(item => item.slug == page_courante)|length > 0 %}
                <div class="nav-section {{ active_dans ? 'has-active' : '' }}" data-section="{{ sec.key }}">
                    <button type="button" class="nav-section-head" aria-expanded="false" aria-controls="nav-menu-{{ sec.key }}">
                        <span class="nav-section-title"><i class="bi {{ sec.icon }}"></i><span>{{ sec.titre }}</span></span>
                        <i class="bi bi-chevron-down nav-section-chevron" aria-hidden="true"></i>
                    </button>
                    <div class="nav-section-body" id="nav-menu-{{ sec.key }}">
                        <span class="nav-menu-caption">{{ sec.titre }}</span>
                        {% for item in sec.items %}
                            {% if item.slug != 'tableau_bord' %}
                                <a class="nav-link {{ page_courante == item.slug ? 'active' : '' }}" href="{{ item.href|default(item.slug ~ '.php') }}" {% if page_courante == item.slug %}aria-current="page"{% endif %}>
                                    <span class="nav-icon {{ item.color }}"><i class="bi {{ item.icon }}" aria-hidden="true"></i></span>
                                    <span>{{ item.label }}</span>
                                    {% if item.badge|default(0) > 0 %}
                                        <span class="badge bg-danger ms-auto">{{ item.badge }}</span>
                                    {% endif %}
                                </a>
                            {% endif %}
                        {% endfor %}
                    </div>
                </div>
            {% endfor %}

            </div>
    </nav>
    <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

    <div class="app-main" id="appMain">
        <div class="page-heading">
            <div class="page-heading-crumb"><i class="bi bi-grid-1x2"></i><span>{{ app_nom }}</span><i class="bi bi-chevron-right" aria-hidden="true"></i><strong>{{ titre_page|default(app_nom) }}</strong></div>
            <div class="page-heading-row">
                <div><h1>{{ titre_page|default(app_nom) }}</h1>{% if sous_titre is defined and sous_titre %}<p>{{ sous_titre }}</p>{% endif %}</div>
                <time class="page-date" datetime="{{ 'now'|date('Y-m-d') }}"><i class="bi bi-calendar3"></i><span>{{ 'now'|date('d/m/Y') }}</span></time>
            </div>
        </div>
        <main class="app-content" id="appContent">

{% else %}
<main class="app-content">
{% endif %}

        {% block body %}{% endblock %}

        </main><!-- /.app-content -->
    </div><!-- /.app-main -->
</div><!-- /.app-shell -->

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/jsbarcode@3.11.6/dist/JsBarcode.all.min.js"></script>
    <script nonce="{{ csp_nonce_val }}">window.BASE_URL = {{ base_url|json_encode|raw }};</script>
    <script nonce="{{ csp_nonce_val }}" src="{{ base_url }}assets/js/app.js?v=6"></script>
<script nonce="{{ csp_nonce_val }}">
if ('serviceWorker' in navigator) {
    navigator.serviceWorker.register('{{ base_url }}sw.js').catch(function(){});
}
</script>
{% block scripts_extra %}{% endblock %}

{# ---- Toast container pour les messages flash ---- #}
<div class="toast-container position-fixed top-0 end-0 p-3" style="z-index:1090;" id="flashToastContainer"></div>
<script nonce="{{ csp_nonce_val }}">
(function(){
    var msgs = {{ flash_messages|json_encode|raw }};
    if (!msgs || !msgs.length) return;
    var icons = {success:'check-circle-fill', danger:'exclamation-triangle-fill', warning:'exclamation-triangle-fill', info:'info-circle-fill'};
    var container = document.getElementById('flashToastContainer');
    msgs.forEach(function(f){
        var toastEl = document.createElement('div');
        toastEl.className = 'toast align-items-center text-bg-' + (f.type === 'danger' ? 'danger' : f.type) + ' border-0';
        toastEl.setAttribute('role','alert');
        toastEl.setAttribute('aria-live','assertive');
        toastEl.setAttribute('aria-atomic','true');
        toastEl.innerHTML =
            '<div class="d-flex">' +
              '<div class="toast-body"><i class="bi bi-' + (icons[f.type]||'bell') + ' me-2"></i>' + f.message + '</div>' +
              '<button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>' +
            '</div>';
        container.appendChild(toastEl);
        var toast = new bootstrap.Toast(toastEl, {delay: 5000});
        toast.show();
        toastEl.addEventListener('hidden.bs.toast', function(){ toastEl.remove(); });
    });
})();
</script>
</body>
</html>
