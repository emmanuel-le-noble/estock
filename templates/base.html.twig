{# templates/base.html.twig - Layout maitre eStock #}

{% set user = current_user %}
{% set role = current_role %}
{% set app_nom = param_app_name() %}
{% set initiale = (user.nom|default('U')|trim)|slice(0,1)|upper %}

{# ---- Theme ---- #}
{% set theme_palettes = {
    'indigo':  ['#6366f1','#4f46e5','#eef2ff'],
    'emerald': ['#10b981','#059669','#ecfdf5'],
    'sky':     ['#0ea5e9','#0284c7','#e0f2fe'],
    'rose':    ['#f43f5e','#e11d48','#fff1f2'],
    'amber':   ['#f59e0b','#d97706','#fffbeb']
} %}
{% set theme_colour = param('theme_couleur', 'indigo') %}
{% set theme_vars = theme_palettes[theme_colour]|default(theme_palettes.indigo) %}

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ titre_page|default(app_nom) }} · {{ app_nom }}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link href="{{ base_url }}assets/css/style.css" rel="stylesheet">
    <style>
        :root {
            --brand: {{ theme_vars[0]|escape('css') }};
            --brand-2: {{ theme_vars[1]|escape('css') }};
            --brand-soft: {{ theme_vars[2]|escape('css') }};
        }
    </style>
    {% block head_extra %}{% endblock %}
</head>
<body>

{% if is_logged_in %}
<div class="app-shell">

    <!-- ============ SIDEBAR ============ -->
    <aside class="sidebar" id="sidebar">
        <div class="sidebar-brand">
            <span class="logo-mark"><i class="bi bi-boxes"></i></span>
            <span class="brand-text">{{ app_nom }}</span>
        </div>

        <nav class="sidebar-nav">
            {# ── SECTION : TABLEAU DE BORD ── #}
            <div class="nav-section-label">Tableau de bord</div>
            <a class="nav-link {{ page_courante == 'tableau_bord' ? 'active' : '' }}"
               href="tableau_bord.php">
                <i class="bi bi-speedometer2"></i>
                <span>Accueil</span>
            </a>
            {% if can_admin %}
            <a class="nav-link {{ page_courante == 'statistiques' ? 'active' : '' }}"
               href="statistiques.php">
                <i class="bi bi-graph-up"></i>
                <span>Statistiques</span>
            </a>
            {% endif %}

            {# ── SECTION : LOGISTIQUE ── #}
            {% if can_manage_stock %}
            <div class="nav-section-label">Logistique</div>
            <div class="nav-group {{ page_courante in ['stock','articles','categories','fournisseurs','commandes_fournisseur','inventaire','mouvements','transferts','peremptions'] ? 'active' : '' }}">
                <button class="sidebar-dropdown-toggle"
                        aria-expanded="{{ page_courante in ['stock','articles','categories','fournisseurs','commandes_fournisseur','inventaire','mouvements','transferts','peremptions'] ? 'true' : 'false' }}">
                    <i class="bi bi-boxes"></i>
                    <span>Stocks</span>
                    <i class="bi bi-chevron-right dropdown-arrow"></i>
                </button>
                <div class="sidebar-submenu">
                    <a class="nav-link {{ page_courante == 'stock' ? 'active' : '' }}"
                       href="stock.php">
                        <i class="bi bi-boxes"></i>
                        <span>Stock</span>
                    </a>
                    <a class="nav-link {{ page_courante == 'articles' ? 'active' : '' }}"
                       href="articles.php">
                        <i class="bi bi-box-seam"></i>
                        <span>Articles</span>
                    </a>
                    {% if peut('articles_gerer') %}
                    <a class="nav-link {{ page_courante == 'categories' ? 'active' : '' }}"
                       href="categories.php">
                        <i class="bi bi-tags"></i>
                        <span>Catégories</span>
                    </a>
                    {% endif %}
                    <a class="nav-link {{ page_courante == 'fournisseurs' ? 'active' : '' }}"
                       href="fournisseurs.php">
                        <i class="bi bi-truck"></i>
                        <span>Fournisseurs</span>
                    </a>
                    {% if peut('achats_consulter') %}
                    <a class="nav-link {{ page_courante == 'commandes_fournisseur' ? 'active' : '' }}"
                       href="commandes_fournisseur.php">
                        <i class="bi bi-cart-plus"></i>
                        <span>Commandes d'achat</span>
                    </a>
                    {% endif %}
                    {% if peut('inventaire_consulter') %}
                    <a class="nav-link {{ page_courante == 'inventaire' ? 'active' : '' }}"
                       href="inventaire.php">
                        <i class="bi bi-clipboard-check"></i>
                        <span>Inventaire</span>
                    </a>
                    {% endif %}
                    <a class="nav-link {{ page_courante == 'mouvements' ? 'active' : '' }}"
                       href="mouvements.php">
                        <i class="bi bi-arrow-left-right"></i>
                        <span>Mouvements</span>
                    </a>
                    <a class="nav-link {{ page_courante == 'peremptions' ? 'active' : '' }}"
                       href="peremptions.php">
                        <i class="bi bi-calendar-week"></i>
                        <span>Péremptions</span>
                        {% if (nb_alertes_peremption|default(0)) > 0 %}
                            <span class="badge bg-danger ms-auto">{{ nb_alertes_peremption }}</span>
                        {% endif %}
                    </a>
                    {% if current_role in ['Directeur', 'Admin', 'Magasinier'] %}
                    <a class="nav-link {{ page_courante == 'etiquettes' ? 'active' : '' }}"
                       href="etiquettes.php">
                        <i class="bi bi-tag"></i>
                        <span>Étiquettes rayon</span>
                    </a>
                    <a class="nav-link {{ page_courante == 'transferts' ? 'active' : '' }}"
                       href="transferts.php">
                        <i class="bi bi-arrow-right-arrow-left"></i>
                        <span>Transferts</span>
                    </a>
                    {% endif %}
                </div>
            </div>
            {% endif %}

            {# ── SECTION : VENTES ── #}
            {% if can_bill %}
            <div class="nav-group {{ page_courante in ['caisse','factures','retours','cloture'] ? 'active' : '' }}">
                <button class="sidebar-dropdown-toggle"
                        aria-expanded="{{ page_courante in ['caisse','factures','retours','cloture'] ? 'true' : 'false' }}">
                    <i class="bi bi-cart-check"></i>
                    <span>Ventes</span>
                    <i class="bi bi-chevron-right dropdown-arrow"></i>
                </button>
                <div class="sidebar-submenu">
                    <a class="nav-link {{ page_courante == 'caisse' ? 'active' : '' }}"
                       href="caisse.php">
                        <i class="bi bi-cart-check"></i>
                        <span>Caisse</span>
                    </a>
                    <a class="nav-link {{ page_courante == 'factures' ? 'active' : '' }}"
                       href="factures.php">
                        <i class="bi bi-receipt"></i>
                        <span>Factures</span>
                    </a>
                    {% if peut('retours_consulter') %}
                    <a class="nav-link {{ page_courante == 'retours' ? 'active' : '' }}"
                       href="retours.php">
                        <i class="bi bi-arrow-counterclockwise"></i>
                        <span>Retours / SAV</span>
                    </a>
                    {% endif %}
                    {% if peut('promotions_consulter') %}
                    <a class="nav-link {{ page_courante == 'promotions' ? 'active' : '' }}"
                       href="promotions.php">
                        <i class="bi bi-percent"></i>
                        <span>Promotions & Remises</span>
                    </a>
                    {% endif %}
                    <a class="nav-link {{ page_courante == 'cloture' ? 'active' : '' }}"
                       href="cloture.php">
                        <i class="bi bi-lock-fill"></i>
                        <span>Clôture de Caisse</span>
                    </a>
                </div>
            </div>
            {% endif %}

            {# ── SECTION : ADMINISTRATION ── #}
            {% if can_admin %}
            <div class="nav-section-label">Administration</div>
            <a class="nav-link {{ page_courante == 'depenses' ? 'active' : '' }}"
               href="depenses.php">
                <i class="bi bi-wallet2"></i>
                <span>Dépenses</span>
            </a>
            <div class="nav-group {{ page_courante in ['utilisateurs','magasins','parametres'] ? 'active' : '' }}">
                <button class="sidebar-dropdown-toggle"
                        aria-expanded="{{ page_courante in ['utilisateurs','magasins','parametres'] ? 'true' : 'false' }}">
                    <i class="bi bi-gear"></i>
                    <span>Paramètres</span>
                    <i class="bi bi-chevron-right dropdown-arrow"></i>
                </button>
                <div class="sidebar-submenu">
                    <a class="nav-link {{ page_courante == 'utilisateurs' ? 'active' : '' }}"
                       href="utilisateurs.php">
                        <i class="bi bi-people"></i>
                        <span>Utilisateurs</span>
                    </a>
                    <a class="nav-link {{ page_courante == 'magasins' ? 'active' : '' }}"
                       href="magasins.php">
                        <i class="bi bi-shop"></i>
                        <span>Magasins</span>
                    </a>
                    <a class="nav-link {{ page_courante == 'parametres' ? 'active' : '' }}"
                       href="parametres.php">
                        <i class="bi bi-gear"></i>
                        <span>Paramètres</span>
                    </a>
                </div>
            </div>
            {% endif %}
        </nav>

        {# ── FOOTER : MON COMPTE ── #}
        <div class="sidebar-footer">
            {% if peut('audit_consulter') %}
            <a class="side-user {{ page_courante == 'audit' ? 'active' : '' }}" href="audit.php" title="Journal d'activité">
                <span class="avatar avatar-accent"><i class="bi bi-clock-history"></i></span>
                <span class="meta">
                    <span class="nm">Journal d'activité</span>
                </span>
            </a>
            {% endif %}
            {% if current_role in ['Directeur', 'Admin', 'Vendeur'] %}
            <a class="side-user {{ page_courante == 'cloture' ? 'active' : '' }}" href="cloture.php" title="Clôturer la caisse">
                <span class="avatar" style="background:#f59e0b;"><i class="bi bi-lock-fill"></i></span>
                <span class="meta">
                    <span class="nm">Clôturer la Caisse</span>
                </span>
            </a>
            {% endif %}
            <a class="side-user {{ page_courante == 'profil' ? 'active' : '' }}" href="profil.php" title="Mon profil">
                <span class="avatar avatar-initial">{{ initiale }}</span>
                <span class="meta">
                    <span class="nm">{{ user.nom|default('') }}</span>
                    <span class="rl">{{ role }}</span>
                </span>
            </a>
            <form method="POST" action="logout.php" class="d-inline">
                <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                <button type="submit" class="side-user btn btn-link text-decoration-none" title="Se deconnecter" style="background:none;border:none;">
                    <span class="avatar avatar-logout"><i class="bi bi-box-arrow-right"></i></span>
                    <span class="meta">
                        <span class="nm">Déconnexion</span>
                    </span>
                </button>
            </form>
        </div>
    </aside>
    <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

    <!-- ============ CONTENU ============ -->
    <div class="app-main">
        <header class="app-topbar">
            <div class="d-flex align-items-center gap-2">
                <button class="burger" id="burger" aria-label="Menu"><i class="bi bi-list"></i></button>
                <div>
                    <h1>{{ titre_page|default(app_nom) }}</h1>
                    {% if sous_titre is defined and sous_titre %}
                        <div class="crumb">{{ sous_titre }}</div>
                    {% endif %}
                </div>
            </div>
            <div class="d-none d-md-flex align-items-center gap-2">
                <span id="connectionBadge"></span>
                {% if can_bill %}
                    <a href="caisse.php" class="btn btn-success btn-sm"><i class="bi bi-cart-check"></i> Caisse</a>
                {% endif %}
                {% if can_manage_stock %}
                    <a href="suggestions_achat.php"
                       class="btn btn-sm {{ (nb_alertes_topbar|default(0)) > 0 ? 'btn-outline-warning' : 'btn-outline-secondary' }}"
                       title="Alertes stock">
                        <i class="bi bi-bell"></i>
                        {% if (nb_alertes_topbar|default(0)) > 0 %}
                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                                {{ nb_alertes_topbar }}
                            </span>
                        {% endif %}
                    </a>
                {% endif %}
                {% if peut('stock_consulter') and (nb_alertes_peremption|default(0)) > 0 %}
                    <a href="peremptions.php"
                       class="btn btn-sm btn-outline-danger position-relative"
                       title="Alertes péremption">
                        <i class="bi bi-calendar-week"></i>
                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                            {{ nb_alertes_peremption }}
                        </span>
                    </a>
                {% endif %}
                <a href="tableau_bord.php" class="btn btn-outline-secondary btn-sm"><i class="bi bi-house-door"></i></a>
            </div>
        </header>

        <main class="app-content" id="appMain">
        {# ---- Flash messages ---- #}
        {% for f in flash_messages|default([]) %}
            {% set icons = {success:'check-circle', danger:'exclamation-triangle', warning:'exclamation-triangle', info:'info-circle'} %}
            <div class="alert alert-{{ f.type }} alert-dismissible fade show" role="alert">
                <i class="bi bi-{{ icons[f.type]|default('bell') }}"></i> {{ f.message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endfor %}

{% else %}
<main class="app-content">
{% endif %}

        {% block body %}{% endblock %}

        </main><!-- /.app-content -->
    </div><!-- /.app-main -->
</div><!-- /.app-shell -->

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/jsbarcode@3.11.6/dist/JsBarcode.all.min.js"></script>
<script nonce="{{ csp_nonce_val }}" src="{{ base_url }}assets/js/app.js"></script>
{% block scripts_extra %}{% endblock %}
</body>
</html>
