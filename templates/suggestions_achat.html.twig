{% extends "base.html.twig" %}

{% block body %}
<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <div>
        <span class="badge text-bg-danger fs-6">{{ nb_total|default(0) }} article{{ (nb_total|default(0)) > 1 ? 's' : '' }} en alerte</span>
    </div>
    <div class="d-flex gap-2">
        {% if (nb_total|default(0)) > 0 %}
            <button class="btn btn-outline-secondary" onclick="window.print()">
                <i class="bi bi-printer"></i> Imprimer la liste
            </button>
        {% endif %}
        <a href="{{ base_url }}stock.php" class="btn btn-outline-primary">
            <i class="bi bi-boxes"></i> Consultation stock
        </a>
    </div>
</div>

{% if (nb_total|default(0)) == 0 %}
    <div class="card shadow-sm">
        <div class="card-body text-center py-5">
            <i class="bi bi-check-circle text-success fs-1 d-block mb-3"></i>
            <h5 class="text-success">Tout est en ordre !</h5>
            <p class="text-muted mb-0">Aucun article n'est en dessous du seuil d'alerte de stock.</p>
        </div>
    </div>
{% else %}
    {% for g in groupes|default([]) %}
        <div class="card shadow-sm mb-3">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0">
                    <i class="bi bi-truck text-primary"></i>
                    {{ g.fournisseur_nom|default('Sans fournisseur') }}
                </h5>
                {% set nb = g.articles|default([])|length %}
                <span class="badge text-bg-secondary">{{ nb }} article{{ nb > 1 ? 's' : '' }}</span>
            </div>
            <div class="card-body">
                {% if g.contact|default('') or g.telephone|default('') %}
                    <div class="mb-3 text-muted small">
                        {% if g.contact|default('') %}
                            <span><i class="bi bi-person"></i> {{ g.contact }}</span>
                        {% endif %}
                        {% if g.contact|default('') and g.telephone|default('') %} · {% endif %}
                        {% if g.telephone|default('') %}
                            <span><i class="bi bi-telephone"></i> {{ g.telephone }}</span>
                        {% endif %}
                    </div>
                {% endif %}

                <div class="table-responsive">
                    <table class="table table-sm table-hover mb-0 align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Article</th>
                                <th>Code-barres</th>
                                <th>Emplacement</th>
                                <th class="text-center">Stock actuel</th>
                                <th class="text-center">Seuil alerte</th>
                                <th class="text-end">Prix vente</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for a in g.articles|default([]) %}
                                <tr class="{{ a.quantite_stock|default(0) == 0 ? 'table-danger' : 'table-warning' }}">
                                    <td class="fw-semibold">{{ a.nom|default('') }}</td>
                                    <td><code>{{ a.code_barre|default('') }}</code></td>
                                    <td>{{ a.emplacement|default('') ?: '—' }}</td>
                                    <td class="text-center">
                                        <span class="badge text-bg-{{ a.quantite_stock|default(0) == 0 ? 'danger' : 'warning' }}">
                                            {{ a.quantite_stock|default(0) }}
                                        </span>
                                    </td>
                                    <td class="text-center">{{ a.seuil_alerte|default(0) }}</td>
                                    <td class="text-end">{{ money(a.prix_vente|default(0)) }}</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    {% endfor %}
{% endif %}
{% endblock %}
