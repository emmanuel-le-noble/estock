{# ticket_print.html.twig — Ticket thermique 80mm, autonome (pas de base.html.twig) #}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ticket {{ facture.numero_facture }}</title>
    <link rel="icon" type="image/x-icon" href="{{ base_url|trim('/', 'right') }}/assets/images/logo-eStock.ico">
    <style>
        :root {
            --doc-red: #D52B1E;
            --doc-green: #8DC63F;
            --doc-orange: #F57C00;
        }
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            font-family: 'Courier New', Courier, monospace;
            font-size: 12px;
            color: #000;
            background: #fff;
            width: 80mm;
            margin: 0 auto;
            padding: 4mm;
            line-height: 1.35;
        }
        .ticket { width: 100%; }
        h1 { font-size: 16px; text-align: center; margin-bottom: 2mm; }
        .shop-info { text-align: center; font-size: 11px; margin-bottom: 3mm; }
        .ticket-hr { border-top: 1px dashed #000; margin: 2.5mm 0; }
        .ticket-hr-thick { border-top: 2px solid #000; margin: 2.5mm 0; }
        .chevron-top {
            height: 6px;
            background: linear-gradient(135deg, var(--doc-green) 50%, transparent 50%);
            margin-bottom: 2mm;
        }
        .chevron-bottom {
            height: 6px;
            background: linear-gradient(-45deg, var(--doc-red) 50%, transparent 50%);
            margin-top: 2mm;
        }
        .doc-title {
            text-align: center;
            font-size: 14px;
            font-weight: 700;
            color: var(--doc-red);
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 2mm;
        }
        .legal-info {
            text-align: center;
            font-size: 9px;
            color: #666;
            margin-top: 2mm;
            line-height: 1.3;
        }
        table { width: 100%; border-collapse: collapse; }
        td, th { padding: 0.8mm 0; }
        .text-right { text-align: right; }
        .text-center { text-align: center; }
        .fw-bold { font-weight: 700; }
        .fs-sm { font-size: 10px; }
        .fs-lg { font-size: 14px; }
        .mt-1 { margin-top: 1mm; }
        .mb-1 { margin-bottom: 1mm; }
        .footer-msg { text-align: center; font-size: 10px; margin-top: 3mm; }
        @media print {
            body { padding: 0; width: 80mm; }
            .no-print { display: none !important; }
        }
        @page { size: 80mm auto; margin: 0; }
    </style>
</head>
<body>
<div class="ticket">

    {# --- En-tête magasin --- #}
    {% if magasin is defined and magasin %}
        <h1>{{ magasin.nom }}</h1>
        <div class="shop-info">
            {% if magasin.adresse is defined and magasin.adresse %}{{ magasin.adresse }}<br>{% endif %}
            {% if magasin.telephone is defined and magasin.telephone %}Tél: {{ magasin.telephone }}<br>{% endif %}
            {% if magasin.email is defined and magasin.email %}{{ magasin.email }}{% endif %}
            {% if magasin.nif is defined and magasin.nif %}<br>NIF: {{ magasin.nif }}{% endif %}
            {% if magasin.rccm is defined and magasin.rccm %}<br>RCCM: {{ magasin.rccm }}{% endif %}
        </div>
    {% else %}
        <h1>{{ param('app_nom', 'eStock') }}</h1>
    {% endif %}
    {% if nif_boutique is defined and nif_boutique %}
    <div class="shop-info">NIF: {{ nif_boutique }}{% if rccm_boutique is defined and rccm_boutique %} · RCCM: {{ rccm_boutique }}{% endif %}</div>
    {% endif %}

    {# --- Bandeau chevron vert (sous l'en-tête) --- #}
    <div class="chevron-top"></div>

    <div class="ticket-hr-thick"></div>

    {# --- Infos facture --- #}
    <div class="doc-title">Facture</div>
    <table>
        <tr>
            <td class="fw-bold">Numéro</td>
            <td class="text-right">{{ facture.numero_facture }}</td>
        </tr>
        <tr>
            <td>Date</td>
            <td class="text-right">{{ facture.date_facture is defined and facture.date_facture ? facture.date_facture|date('d/m/Y H:i') : '' }}</td>
        </tr>
        <tr>
            <td>Vendeur</td>
            <td class="text-right">{{ facture.vendeur_nom|default('') }}</td>
        </tr>
        {% if facture.client_nom is defined and facture.client_nom %}
        <tr>
            <td>Client</td>
            <td class="text-right">{{ facture.client_nom }}</td>
        </tr>
        {% endif %}
    </table>

    <div class="ticket-hr"></div>

    {# --- Lignes d'articles --- #}
    <table>
        <thead>
            <tr>
                <th>Article</th>
                <th class="text-center">Qte</th>
                <th class="text-right">P.U.</th>
                <th class="text-right">Sous-total</th>
            </tr>
        </thead>
        <tbody>
        {% for ligne in lignes %}
            {% set nom_article = ligne.article_nom|default('') %}
            {% set qte = ligne.quantite|default(0) %}
            {% set pu = ligne.prix_unitaire|default(0) %}
            <tr>
                <td>
                    {{ nom_article|length > 24 ? nom_article|slice(0, 23) ~ '…' : nom_article }}
                    {% if ligne.remise_pct is defined and ligne.remise_pct %}
                        <br><span class="fs-sm">  -{{ ligne.remise_pct }}%</span>
                    {% endif %}
                </td>
                <td class="text-center">{{ qte }}</td>
                <td class="text-right">{{ pu|number_format(decimals|default(0), '.', ' ') }}</td>
                <td class="text-right fw-bold">{{ (pu * qte)|number_format(decimals|default(0), '.', ' ') }}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <div class="ticket-hr-thick"></div>

    {# --- Totaux --- #}
    <table>
        <tr>
            <td>Total HT</td>
            <td class="text-right">{{ facture.total_ht|number_format(decimals|default(0), '.', ' ') }} {{ devise|default('') }}</td>
        </tr>
        {# --- TVA : ventilation multi-taux ou taux unique --- #}
        {% if tva_resume is defined and tva_resume|length >= 1 %}
            {% for tv in tva_resume %}
            <tr>
                <td>TVA {{ tv.taux|number_format(decimals|default(0), '.', ' ') }}%</td>
                <td class="text-right">{{ tv.montant_tva|number_format(decimals|default(0), '.', ' ') }} {{ devise|default('') }}</td>
            </tr>
            {% endfor %}
        {% elseif tva_taux is defined and tva_taux > 0 %}
        <tr>
            <td>TVA ({{ tva_taux }}%)</td>
            <td class="text-right">{{ (facture.total_ttc - facture.total_ht)|number_format(decimals|default(0), '.', ' ') }} {{ devise|default('') }}</td>
        </tr>
        {% elseif regime_tpu is defined and regime_tpu %}
        <tr>
            <td colspan="2" class="text-center fs-sm fw-bold">TVA non applicable (TPU)</td>
        </tr>
        {% endif %}
        <tr>
            <td class="fw-bold fs-lg">TOTAL TTC</td>
            <td class="text-right fw-bold fs-lg">{{ facture.total_ttc|number_format(decimals|default(0), '.', ' ') }} {{ devise|default('') }}</td>
        </tr>
        {% if facture.points_utilises is defined and facture.points_utilises > 0 %}
        <tr>
            <td>Dont remise fidélité (−{{ facture.points_utilises }} pts)</td>
            <td class="text-right">{{ facture.remise_fidelite|default(0)|number_format(decimals|default(0), '.', ' ') }} {{ devise|default('') }}</td>
        </tr>
        {% endif %}
    </table>

    {% if points_gagnes is defined and points_gagnes > 0 %}
    <div class="ticket-hr"></div>
    <table>
        <tr>
            <td class="fw-bold">POINTS FIDÉLITÉ</td>
            <td class="text-right fw-bold">+{{ points_gagnes }} pts</td>
        </tr>
    </table>
    {% endif %}

    <div class="ticket-hr"></div>

    {# --- Paiements --- #}
    <div class="fw-bold mb-1">PAIEMENTS</div>
    <table>
    {% if paiements is defined and paiements|length > 0 %}
        {% for p in paiements %}
        <tr>
            <td>{{ p.mode_paiement|default('') }}</td>
            <td class="text-right">{{ p.montant|default(0)|number_format(decimals|default(0), '.', ' ') }} {{ devise|default('') }}</td>
        </tr>
        {% endfor %}
    {% else %}
        <tr>
            <td>Especes</td>
            <td class="text-right">{{ facture.montant_paye|default(0)|number_format(decimals|default(0), '.', ' ') }} {{ devise|default('') }}</td>
        </tr>
    {% endif %}
        <tr>
            <td class="fw-bold">Montant payé</td>
            <td class="text-right fw-bold">{{ facture.montant_paye|default(0)|number_format(decimals|default(0), '.', ' ') }} {{ devise|default('') }}</td>
        </tr>
        {% if facture.monnaie_rendue is defined and facture.monnaie_rendue > 0 %}
        <tr>
            <td class="fw-bold">Monnaie rendue</td>
            <td class="text-right fw-bold">{{ facture.monnaie_rendue|number_format(decimals|default(0), '.', ' ') }} {{ devise|default('') }}</td>
        </tr>
        {% endif %}
    </table>

    <div class="ticket-hr-thick"></div>

    {# --- Footer --- #}
    <div class="footer-msg">
        Merci pour votre achat !<br>
        {{ "now"|date('d/m/Y') }}
    </div>

    {# --- Infos légales --- #}
    {% if nif_boutique is defined and nif_boutique %}
    <div class="legal-info">
        {{ param('app_nom', 'eStock') }} — NIF: {{ nif_boutique }}{% if rccm_boutique is defined and rccm_boutique %} · RCCM: {{ rccm_boutique }}{% endif %}
    </div>
    {% endif %}

    {# --- Code-barres facture (optionnel) --- #}
    <div class="text-center mt-1" id="barcodeFacture"></div>

    {# --- Bandeau chevron rouge (bas) --- #}
    <div class="chevron-bottom"></div>

</div>

{# Script JsBarcode pour code-barres facture (impression) #}
<script src="https://cdn.jsdelivr.net/npm/jsbarcode@3.11.6/dist/JsBarcode.all.min.js"></script>

{# Donnée transmise via un bloc JSON dédié : évite que l'éditeur (VSCode) confonde {{ }} avec un objet JS #}
<script type="application/json" id="ticket-data">{"numeroFacture": {{ facture.numero_facture|json_encode|raw }}}</script>

<script nonce="{{ csp_nonce_val|default('') }}">
    var numeroFacture = JSON.parse(document.getElementById('ticket-data').textContent).numeroFacture;

    function genererCodeBarre() {
        try {
            if (typeof JsBarcode === 'undefined') {
                return false;
            }
            JsBarcode('#barcodeFacture', numeroFacture, {
                format: 'CODE128',
                width: 1.2,
                height: 30,
                displayValue: true,
                fontSize: 10,
                margin: 2
            });
            return true;
        } catch (e) {
            console.warn('Code-barres non généré :', e);
            return false;
        }
    }

    window.addEventListener('load', function () {
        genererCodeBarre();
        setTimeout(function () { window.print(); }, 400);
    });
</script>
</body>
</html>
